# MEME HUNTER - Railway Deployment
# =================================

# Railway Environment Variables
# ============================
# Set these in Railway Dashboard > Variables

# Paper trading is the default and does not need a private key.
PAPER_TRADING=true
PAPER_STARTING_BALANCE_SOL=1.0

# Read-only GMGN KOL/smart-money feed. Add this directly in Railway; do not
# commit or paste the key into chat.
GMGN_API_KEY=your_read_only_gmgn_api_key
GMGN_TOKEN_ENRICH_PER_HOUR=50

# Only set this after explicitly switching PAPER_TRADING=false.
# WALLET_PRIVATE_KEY=your_base58_private_key_here

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_BotFather
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Solana RPC Endpoint (use premium for better reliability)
# Free: https://api.mainnet-beta.solana.com
# Premium (recommended): Helius, QuickNode, Triton, etc.
RPC_ENDPOINT=https://api.mainnet-beta.solana.com


# OPTIONAL
# ---------

# Jupiter API Key (for higher rate limits)
JUPITER_API_KEY=

# Additional RPC endpoints (for fallback)
RPC_FALLBACK_1=https://rpc.ankr.com/solana
RPC_FALLBACK_2=https://solana-mainnet.rpc.exnode.io


# Trading Configuration - Selectivity Framework V2
# --------------------------------------------
# With a 1 SOL startup balance, these defaults cap one meme at 0.1 SOL,
# cap total open exposure at 0.8 SOL, and preserve 0.05 SOL as reserve.
ALLOCATION_PER_MEME_PCT=10
MAX_PORTFOLIO_ALLOCATION_PCT=80
MIN_SOL_RESERVE=0.05
MIN_TRADE_SOL=0.005
MAX_POSITION_PER_COIN=0.1
MAX_COINS_TRACKED=10

# DCA - with cooldown to avoid falling knife
DCA_ENTRIES=3
DCA_WAIT_FOR_DIPS=true
DCA_COOLDOWN_SECONDS=15
DCA_SPACING_PCT=10

# Grid + Moon Bag
GRID_LEVELS=5
FIRST_TP_PCT=50
GRID_SPACING_PCT=15
MOON_BAG_PCT=20
ENABLE_MCAP_TP=true

# Risk & Selectivity - MELT-inspired
STOP_LOSS_PCT=30
TRAILING_STOP_ACTIVATION_PCT=50
TRAILING_STOP_DISTANCE_PCT=15
TIME_EXCEED_SECONDS=300
DEV_DUMP_THRESHOLD_PCT=15
LIQUIDITY_DROP_THRESHOLD_PCT=50
MAX_BUNDLE_RISK_SCORE=70
MAX_WASH_SCORE=70
MAX_SNIPER_SATURATION_SCORE=80
MAX_FUNDING_CLUSTER_RISK=70
SERIAL_DEPLOYER_THRESHOLD=3

# Fees & Whale Safety
PAPER_FEE_BPS=100
PAPER_SLIPPAGE_BPS=50
MIN_CONFIRMING_WHALES=2
MAX_WHALE_MULTIPLIER=1.25
MAX_CONCURRENT_WHALE_POSITIONS=5
WHALE_MIN_TRADES=20
WHALE_MIN_WIN_RATE=55

# Scanners - faster but still selective
PUMPFUN_POLL_INTERVAL_SECONDS=3
GECKO_POLL_INTERVAL_SECONDS=30
ENABLE_PUMPFUN_API_SCANNER=true
ENABLE_GECKO_SCANNER=true
# Optional logsSubscribe for <1s detection (needs Helius WSS)
HELIUS_API_KEY=your_helius_key_for_funding_cluster_and_logs
HELIUS_RPC_WS=wss://atlas-mainnet.helius-rpc.com/?api-key=your_key
LOGS_SUBSCRIBE_ENABLED=false

# Alert Settings
# --------------
ENABLE_TELEGRAM_ALERTS=true
ALERT_THRESHOLD_PNL=10
ALERT_WHALE_MIN_SOL=5

# One Railway Volume mounted at /data. The code derives both DB paths:
# /data/trade_history.db and /data/wallets_list.db
DATA_DIR=/data
AUTO_LEARN_WALLETS=true
LEARNED_WALLET_MIN_PROFIT_SOL=0.01

# Logging
# -------
LOG_LEVEL=INFO
